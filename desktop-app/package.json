{
  "name": "vsm-f1-league-desktop",
  "version": "1.0.0",
  "description": "Desktop app for the VSM F1 League",
  "main": "main.js",
  "author": "Kill3rKai",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.vsmf1league.desktop",
    "productName": "VSM F1 League",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "splash.html",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  }
}
